<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="20dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <!-- Category Name Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Name"
            android:textColor="@color/navy_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginBottom="6dp" />

        <EditText
            android:id="@+id/etDialogCategoryName"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:background="@drawable/bg_input_field"
            android:hint="e.g. Gym, Freelance, Groceries"
            android:textColor="@color/navy_text"
            android:textColorHint="#94A3B8"
            android:textSize="14.5sp"
            android:paddingHorizontal="16dp"
            android:inputType="textCapWords"
            android:singleLine="true" />

        <!-- Category Type Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Category Type"
            android:textColor="@color/navy_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="8dp" />

        <RadioGroup
            android:id="@+id/rgCategoryType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <RadioButton
                android:id="@+id/rbDialogExpense"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Expense"
                android:textColor="@color/navy_text"
                android:textSize="14sp"
                android:textStyle="bold"
                android:checked="true" />

            <RadioButton
                android:id="@+id/rbDialogIncome"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="24dp"
                android:text="Income"
                android:textColor="@color/navy_text"
                android:textSize="14sp"
                android:textStyle="bold" />
        </RadioGroup>

        <!-- Choose Icon Label -->
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Select an Icon"
            android:textColor="@color/navy_text"
            android:textSize="14sp"
            android:textStyle="bold"
            android:layout_marginTop="16dp"
            android:layout_marginBottom="10dp" />

        <!-- Icon Grid Row 1 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:weightSum="5">

            <ImageView
                android:id="@+id/iconFood"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_selected"
                android:padding="10dp"
                android:src="@drawable/ic_category_food" />

            <ImageView
                android:id="@+id/iconShopping"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_shopping" />

            <ImageView
                android:id="@+id/iconTransport"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_transport" />

            <ImageView
                android:id="@+id/iconUtilities"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_utilities" />

            <ImageView
                android:id="@+id/iconInvest"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_invest" />
        </LinearLayout>

        <!-- Icon Grid Row 2 -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="8dp"
            android:weightSum="5">

            <ImageView
                android:id="@+id/iconWork"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_freelance" />

            <ImageView
                android:id="@+id/iconMedical"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_medical" />

            <ImageView
                android:id="@+id/iconEducation"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_education" />

            <ImageView
                android:id="@+id/iconEntertainment"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_category_entertainment" />

            <ImageView
                android:id="@+id/iconWallet"
                android:layout_width="0dp"
                android:layout_height="48dp"
                android:layout_weight="1"
                android:layout_margin="4dp"
                android:background="@drawable/bg_icon_unselected"
                android:padding="10dp"
                android:src="@drawable/ic_field_wallet" />
        </LinearLayout>

    </LinearLayout>
</ScrollView>
