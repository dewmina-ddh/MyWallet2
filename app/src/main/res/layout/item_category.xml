<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/cardCategoryItem"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:background="@drawable/bg_white_card"
    android:padding="16dp"
    android:gravity="center_vertical"
    android:layout_marginBottom="12dp"
    android:foreground="?android:attr/selectableItemBackground">

    <!-- Category Icon -->
    <ImageView
        android:id="@+id/imgCategoryIcon"
        android:layout_width="38dp"
        android:layout_height="38dp"
        android:src="@drawable/ic_category_food"
        android:layout_marginEnd="16dp" />

    <!-- Details Column -->
    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/tvCategoryName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Food &amp; Dining"
            android:textStyle="bold"
            android:textColor="@color/navy_text"
            android:textSize="16sp" />

        <TextView
            android:id="@+id/tvCategoryTotal"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Spent: $0.00"
            android:textColor="#475569"
            android:textSize="13sp"
            android:layout_marginTop="2dp" />

        <TextView
            android:id="@+id/tvCategoryBadge"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Expense"
            android:textColor="@color/expense_red_txt"
            android:textSize="11sp"
            android:textStyle="bold"
            android:background="@drawable/bg_badge_expense"
            android:paddingHorizontal="8dp"
            android:paddingVertical="2dp"
            android:layout_marginTop="4dp" />
    </LinearLayout>

    <!-- Action Buttons Column -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <!-- Edit Category Button -->
        <ImageView
            android:id="@+id/btnEditCategory"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_white"
            android:padding="8dp"
            android:src="@drawable/ic_field_edit"
            android:contentDescription="Edit Category"
            android:layout_marginEnd="6dp" />

        <!-- Delete Category Button -->
        <ImageView
            android:id="@+id/btnDeleteCategory"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_white"
            android:padding="8dp"
            android:src="@drawable/ic_item_trash"
            android:contentDescription="Delete Category"
            android:layout_marginEnd="6dp" />

        <!-- Right Arrow Action Button -->
        <ImageView
            android:id="@+id/btnCategoryArrow"
            android:layout_width="34dp"
            android:layout_height="34dp"
            android:background="@drawable/bg_circle_arrow_dark"
            android:padding="9dp"
            android:src="@drawable/ic_arrow_right"
            android:contentDescription="Category Details" />
    </LinearLayout>

</LinearLayout>